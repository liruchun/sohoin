# Server-only. Copy to .env.local and use your own credentials.
DATABASE_URL=postgresql://sohoin:CHANGE_ME@127.0.0.1:55432/sohoin
BETTER_AUTH_URL=http://127.0.0.1:3194
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# One-time bootstrap only. Remove ADMIN_PASSWORD after creating the account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_12_CHARACTERS
# Only configure when a trusted proxy overwrites this header and protects origin access.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip
# Absolute server-only directory outside public/. Back up this directory with PostgreSQL.
MEDIA_STORAGE_DIR=D:/project/sohoin/.local/media
# Optional operator tools. pg_dump / pg_restore are external PostgreSQL programs.
PG_BIN_DIR=D:/project/sohoin/.local/tools/postgresql17
BACKUP_DIR=D:/project/sohoin/.local/backups
# Restore requires BOTH variables, points to a new database/new media directory only.
# RESTORE_DATABASE_URL=postgresql://sohoin:CHANGE_ME@127.0.0.1:55432/sohoin_restore_drill
# RESTORE_MEDIA_DIR=D:/project/sohoin/.local/restored-media-drill

# Server-only persistent 32-byte base64url key for encrypted public URLs. Back it up separately.
PUBLIC_ID_SECRET=REPLACE_WITH_32_RANDOM_BYTES_BASE64URL
# Public indexing is explicit; local/preview deployments remain noindex.
SITE_URL=https://sohoin.com
SITE_INDEXING_ENABLED=false
